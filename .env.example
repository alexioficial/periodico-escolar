MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="periodico_escolar"

# --- AWS S3 (almacenamiento de imágenes, videos y adjuntos) ---
# Region del bucket
AWS_S3_REGION="us-east-1"
# Nombre del bucket (debe ser PRIVADO; las URLs se firman al servir)
AWS_S3_BUCKET="periodico-escolar-uploads"
# Credenciales del IAM user con permisos s3:PutObject / s3:GetObject / s3:DeleteObject
# sobre el bucket de arriba
AWS_S3_ACCESS_KEY_ID="tu_access_key_id"
AWS_S3_SECRET_ACCESS_KEY="tu_secret_access_key"
# Opcional: endpoint custom para S3-compatibles (MinIO, Cloudflare R2, Backblaze B2).
# Para AWS S3 deja vacío.
AWS_S3_ENDPOINT=""
# Opcional: "true" para forzar path-style URLs (necesario en MinIO y algunos S3-compatibles).
AWS_S3_FORCE_PATH_STYLE="false"
# Opcional: tamaño máximo por archivo en MB (default 10)
MAX_FILE_SIZE_MB="10"

GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"

SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT="587"
SMTP_USER="tu_usuario_smtp"
SMTP_PASS="tu_contraseña_smtp"
SMTP_FROM="No-Reply <no-reply@tudominio.com>"

# URL pública de la app. Usado por SvelteKit para construir URLs absolutas.
ORIGIN="https://tu-dominio.com"

# Tamaño máximo del body que adapter-node acepta. Por defecto 524288 (512KB),
# muy bajo para uploads multimedia. Subimos a 80MB para permitir hasta ~15 archivos
# de 4.5MB cada uno en un solo formulario.
BODY_SIZE_LIMIT=80000000
